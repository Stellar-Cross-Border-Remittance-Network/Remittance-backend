# ---- runtime ----
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ---- data ----
DATABASE_URL=postgres://remittance:remittance@localhost:5432/remittance
REDIS_URL=redis://localhost:6379

# ---- network (testnet by default; NEVER run mainnet without a full audit) ----
NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ALLOW_INSECURE_HTTP=false

# ---- security (generate strong values; see scripts/gen-secrets.sh) ----
JWT_SECRET=change-me-32+random-bytes
JWT_EXPIRES_IN=15m
ENCRYPTION_KEY=change-me-32+bytes-hex-or-string
SEP10_SIGNING_SECRET=
SEP10_CHALLENGE_TTL_SECONDS=300
SEP10_CLIENT_ATTRIBUTION=remittance-backend

# ---- identity ----
SERVER_HOME_DOMAIN=remittance.example.com
WEB_AUTH_DOMAIN=remittance.example.com

# ---- Soroban contract (deploy first: remittance-contracts/scripts/deploy-testnet.sh) ----
CONTRACT_ID=
ADMIN_SECRET=
ORACLE_SECRET=
FEE_OPERATOR_SECRET=

# ---- quote engine ----
QUOTE_TTL_SECONDS=300
PLATFORM_FEE_BPS=50
CORRIDOR_FEE_BPS=0
# Static fallback FX, e.g. {"USDC:GBU.../NGN":"1500","US/NG":"1500"}
CORRIDOR_RATES_JSON=
RATE_PROVIDER_URL=
RATE_PROVIDER_TOKEN=

# ---- operations ----
STREAM_ENABLED=true
POLL_RECONCILE_INTERVAL_MS=60000

# ---- request signing (HMAC over method/path/timestamp/body-hash) ----
# Required in production: internal ops routes fail closed without it.
REQUEST_SIGNING_SECRET=
REQUEST_SIGNING_CLOCK_SKEW_MS=300000

# ---- observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=remittance-backend